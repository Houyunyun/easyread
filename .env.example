# One container, one HTTP port. Set an access code before network exposure.
EASYREAD_BIND_IP=127.0.0.1
EASYREAD_PORT=8765
EASYREAD_ALLOWED_HOSTS=
# Optional FIRST-RUN code (6–256 characters). Blank means disabled for personal use.
# Afterwards, enable/disable/change in Settings → Access protection.
EASYREAD_ACCESS_CODE=

EASYREAD_BUILD_PROXY=
EASYREAD_HTTP_PROXY=
EASYREAD_HTTPS_PROXY=
CLAUDE_CODE_VERSION=stable
CODEX_VERSION=latest
