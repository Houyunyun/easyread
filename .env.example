# HTTPS ports. Defaults are loopback-only; use SSH or configure a trusted LAN.
EASYREAD_BIND_IP=127.0.0.1
EASYREAD_PORT=8765
EASYREAD_TERMINAL_PORT=8766
# Server IPs/domains, not client IPs. Also added to the generated certificate.
EASYREAD_ALLOWED_HOSTS=
# Optional external HTTPS terminal URL when using separate proxy domains.
EASYREAD_TERMINAL_URL=

# Blank password generates a random persistent password on FIRST startup.
# Retrieve: docker compose exec gateway easyread-admin credentials
EASYREAD_ADMIN_USER=admin
EASYREAD_ADMIN_PASSWORD=

# Optional proxies; never put model credentials in the image.
EASYREAD_BUILD_PROXY=
EASYREAD_HTTP_PROXY=
EASYREAD_HTTPS_PROXY=
CLAUDE_CODE_VERSION=stable
CODEX_VERSION=latest
